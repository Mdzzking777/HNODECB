#!/bin/bash
# DelftBlue SLURM template for AFM Stage2light only (case 03).
# Usage:
#   sbatch DHPC/runners/run_stage2light_03_delftblue.slurm
#   sbatch --export=ALL,HNODECB_STAGE2LIGHT_CANDIDATE=4 DHPC/runners/run_stage2light_03_delftblue.slurm

#SBATCH --job-name=afm03_stage2light
#SBATCH --account=education-me-msc-me
#SBATCH --partition=compute-p2
#SBATCH --time=06:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --mem-per-cpu=4000M
#SBATCH --output=logs/slurm_stage2light_03_%j.out

set -euo pipefail

module purge
module load julia

REPO_DIR="$HOME/HNODECB"
cd "$REPO_DIR"
mkdir -p logs logs/stage2_step2a

export JULIA_NUM_THREADS=16
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export HNODECB_SELFTEST=0
export HNODECB_LR_ADAPT="${HNODECB_LR_ADAPT:-1}"
export HNODECB_LR_MIN="${HNODECB_LR_MIN:-1e-30}"
export HNODECB_LR_MAX="${HNODECB_LR_MAX:-2e-3}"
export HNODECB_LR_ETA="${HNODECB_LR_ETA:-0.35}"
export HNODECB_LR_EMA="${HNODECB_LR_EMA:-0.90}"
export HNODECB_LR_TARGET="${HNODECB_LR_TARGET:-0.4}"
export HNODECB_STAGE2_LR_FORCE="${HNODECB_STAGE2_LR_FORCE:-3e-4}"
export HNODECB_STAGE2_OPTIMIZER="${HNODECB_STAGE2_OPTIMIZER:-amsgrad}"
export HNODECB_STAGE2_GRAD_SCALE_P_NET="${HNODECB_STAGE2_GRAD_SCALE_P_NET:-0.2}"
export HNODECB_STAGE2_GRAD_SCALE_MECH="${HNODECB_STAGE2_GRAD_SCALE_MECH:-1.0}"
export HNODECB_STAGE2_GROUP_ADAPT="${HNODECB_STAGE2_GROUP_ADAPT:-1}"
export HNODECB_STAGE2_GROUP_ETA="${HNODECB_STAGE2_GROUP_ETA:-0.15}"
export HNODECB_ODE_MAXITERS="${HNODECB_ODE_MAXITERS:-5000000}"
export HNODECB_STAGE2_EPOCH_RETRIES="${HNODECB_STAGE2_EPOCH_RETRIES:-12}"
export HNODECB_STAGE2_RETRY_LR_FACTOR="${HNODECB_STAGE2_RETRY_LR_FACTOR:-0.2}"
export HNODECB_STAGE2_RETRY_LR_FLOOR="${HNODECB_STAGE2_RETRY_LR_FLOOR:-1e-30}"
export HNODECB_STAGE2_STEP_GUARD="${HNODECB_STAGE2_STEP_GUARD:-1}"
export HNODECB_STAGE2_STEP_RETRIES="${HNODECB_STAGE2_STEP_RETRIES:-6}"
export HNODECB_STAGE2_STEP_RETRY_LR_FACTOR="${HNODECB_STAGE2_STEP_RETRY_LR_FACTOR:-0.1}"
export HNODECB_STAGE2_STEP_MAX_LOSS_INCREASE="${HNODECB_STAGE2_STEP_MAX_LOSS_INCREASE:-1e-6}"
export HNODECB_STAGE2_PLATEAU_EARLY_STOP="${HNODECB_STAGE2_PLATEAU_EARLY_STOP:-0}"
export HNODECB_STAGE2_VERIFY_ADAM_DIR="${HNODECB_STAGE2_VERIFY_ADAM_DIR:-1}"
export HNODECB_STAGE2_LOG_EVERY=1
export HNODECB_STAGE2_AUTOSPAWN="${HNODECB_STAGE2_AUTOSPAWN:-1}"
export HNODECB_STAGE2_SHARD_COUNT=1
export HNODECB_STAGE2_INPUT_TOPK="${HNODECB_STAGE2_INPUT_TOPK:-9}"
export HNODECB_STAGE2LIGHT_CANDIDATE="${HNODECB_STAGE2LIGHT_CANDIDATE:-6}"
export HNODECB_STAGE2_CANDIDATE_INDICES="${HNODECB_STAGE2_CANDIDATE_INDICES:-$HNODECB_STAGE2LIGHT_CANDIDATE}"
export HNODECB_STAGE2_FINAL_TOPK="${HNODECB_STAGE2_FINAL_TOPK:-1}"
export HNODECB_STAGE2_RESULT_BASENAME="${HNODECB_STAGE2_RESULT_BASENAME:-afm_param_stage2light_03.jld}"
export HNODECB_STAGE2_X3R_WEIGHT="${HNODECB_STAGE2_X3R_WEIGHT:-0.0}"
export HNODECB_STAGE2_SCRIPT="${HNODECB_STAGE2_SCRIPT:-afm_param_stage2light_03.jl}"
export HNODECB_STAGE2_NN_WARM_ENABLED="${HNODECB_STAGE2_NN_WARM_ENABLED:-1}"
export HNODECB_STAGE2_NN_WARM_INPUT_BASENAME="${HNODECB_STAGE2_NN_WARM_INPUT_BASENAME:-afm_param_stage1pluslight_03.jld}"
export HNODECB_STAGE2_NN_WARM_RANK="${HNODECB_STAGE2_NN_WARM_RANK:-1}"
export HNODECB_JULIA_PROJECT="$REPO_DIR/HPC_env"
export JULIA_PROJECT="$REPO_DIR/HPC_env"

STAGE2_DRIVER_LOG="logs/stage2_step2a/log2_03_step2a_stage2light_driver_${SLURM_JOB_ID}.txt"
set +e
stdbuf -oL -eL julia --project="$REPO_DIR/HPC_env" runner/stagewise/afm_param_search_stage2light_03.jl 2>&1 | tee "$STAGE2_DRIVER_LOG"
STAGE2_RC=${PIPESTATUS[0]}
set -e

STAGE2_MEM_LOG="logs/stage2_step2a/log2_03_step2a_stage2light_mem_${SLURM_JOB_ID}.txt"
{
  echo "=== Stage2light Resource Summary ==="
  echo "job_id=${SLURM_JOB_ID}"
  date
  if command -v sacct >/dev/null 2>&1; then
    sacct -j "${SLURM_JOB_ID}" --format=JobID,JobName%30,State,Elapsed,AllocCPUS,ReqMem,MaxRSS,MaxVMSize -P
  else
    echo "sacct not found; cannot collect MaxRSS."
  fi
} | tee "$STAGE2_MEM_LOG"

exit "$STAGE2_RC"
