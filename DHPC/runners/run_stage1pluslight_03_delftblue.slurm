#!/bin/bash
# DelftBlue SLURM template for AFM Stage1pluslight only (case 03).
# Usage:
#   sbatch DHPC/runners/run_stage1pluslight_03_delftblue.slurm
#   sbatch --export=ALL,HNODECB_STAGE1PLUSLIGHT_CANDIDATE=4 DHPC/runners/run_stage1pluslight_03_delftblue.slurm

#SBATCH --job-name=afm03_stage1pluslight
#SBATCH --account=education-me-msc-me
#SBATCH --partition=compute-p2
#SBATCH --time=06:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --mem-per-cpu=4000M
#SBATCH --output=logs/stage1pluslight_step2a/slurm_stage1pluslight_03_%j.out

set -euo pipefail

module purge
module load julia

REPO_DIR="$HOME/HNODECB"
cd "$REPO_DIR"
mkdir -p logs logs/stage1pluslight_step2a

export JULIA_NUM_THREADS=16
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
export HNODECB_STAGE1_VARIANT="${HNODECB_STAGE1_VARIANT:-stage1pluslight}"
export HNODECB_STAGE1PLUS_MODE=1
export HNODECB_STAGE1_RESULT_STEM="${HNODECB_STAGE1_RESULT_STEM:-afm_param_stage1pluslight_03}"
export HNODECB_STAGE1PLUS_INPUT_BASENAME="${HNODECB_STAGE1PLUS_INPUT_BASENAME:-afm_param_stage1_03.jld}"
export HNODECB_STAGE1PLUS_INPUT_TOPK="${HNODECB_STAGE1PLUS_INPUT_TOPK:-9}"
export HNODECB_STAGE1PLUSLIGHT_CANDIDATE="${HNODECB_STAGE1PLUSLIGHT_CANDIDATE:-6}"
export HNODECB_STAGE1PLUS_BASE_INDICES="${HNODECB_STAGE1PLUS_BASE_INDICES:-$HNODECB_STAGE1PLUSLIGHT_CANDIDATE}"
export HNODECB_STAGE1_SHARD_COUNT="${HNODECB_STAGE1_SHARD_COUNT:-4}"
export HNODECB_STAGE1PLUS_ARCH_SCREEN_SHARD_COUNT="${HNODECB_STAGE1PLUS_ARCH_SCREEN_SHARD_COUNT:-3}"
export HNODECB_STAGE1PLUS_TRIALS_PER_SHARD="${HNODECB_STAGE1PLUS_TRIALS_PER_SHARD:-250}"
if [[ -z "${HNODECB_STAGE1PLUS_TRIALS_PER_CANDIDATE:-}" ]]; then
  export HNODECB_STAGE1PLUS_TRIALS_PER_CANDIDATE="$((HNODECB_STAGE1_SHARD_COUNT * HNODECB_STAGE1PLUS_TRIALS_PER_SHARD))"
fi
export HNODECB_STAGE1PLUS_FINAL_TOPK="${HNODECB_STAGE1PLUS_FINAL_TOPK:-10}"
export HNODECB_STAGE1PLUS_ZERO_NN="${HNODECB_STAGE1PLUS_ZERO_NN:-0}"
export HNODECB_STAGE1PLUS_ARCH_TRIALS_PER_ARCH="${HNODECB_STAGE1PLUS_ARCH_TRIALS_PER_ARCH:-20}"
export HNODECB_STAGE1PLUS_ARCH_EPOCHS="${HNODECB_STAGE1PLUS_ARCH_EPOCHS:-50}"
unset HNODECB_STAGE1_SHARD_INDEX
export HNODECB_STAGE1_AUTOSPAWN=1
export HNODECB_STAGE1PLUSLIGHT_LOG_SUBDIR="${HNODECB_STAGE1PLUSLIGHT_LOG_SUBDIR:-stage1pluslight_step2a}"
export HNODECB_STAGE1PLUSLIGHT_LOG_PREFIX="${HNODECB_STAGE1PLUSLIGHT_LOG_PREFIX:-log2_03_step2a_stage1pluslight}"
export HNODECB_STAGE1_LOG_EVERY=1
export HNODECB_INF_LOG=1
export HNODECB_LOG_NN_ERR=1
export HNODECB_STAGE1PLUS_ARCH_LR_ADAPT="${HNODECB_STAGE1PLUS_ARCH_LR_ADAPT:-1}"
export HNODECB_STAGE1PLUS_ARCH_LR_MIN="${HNODECB_STAGE1PLUS_ARCH_LR_MIN:-1e-30}"
export HNODECB_STAGE1PLUS_ARCH_LR_MAX="${HNODECB_STAGE1PLUS_ARCH_LR_MAX:-5e1}"
export HNODECB_STAGE1PLUS_ARCH_LR_ETA="${HNODECB_STAGE1PLUS_ARCH_LR_ETA:-0.5}"
export HNODECB_STAGE1PLUS_ARCH_LR_EMA="${HNODECB_STAGE1PLUS_ARCH_LR_EMA:-0.85}"
export HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_P_NET="${HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_P_NET:-0.5}"
export HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_MECH="${HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_MECH:-1.0}"
export HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_P_NET_MIN="${HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_P_NET_MIN:-0.1}"
export HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_P_NET_MAX="${HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_P_NET_MAX:-1.0}"
export HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_MECH_MIN="${HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_MECH_MIN:-0.5}"
export HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_MECH_MAX="${HNODECB_STAGE1PLUS_ARCH_GRAD_SCALE_MECH_MAX:-1.5}"
export HNODECB_STAGE1PLUS_ARCH_GROUP_ADAPT="${HNODECB_STAGE1PLUS_ARCH_GROUP_ADAPT:-1}"
export HNODECB_STAGE1PLUS_ARCH_GROUP_ETA="${HNODECB_STAGE1PLUS_ARCH_GROUP_ETA:-0.05}"
export HNODECB_STAGE1PLUS_ARCH_STEP_GUARD="${HNODECB_STAGE1PLUS_ARCH_STEP_GUARD:-1}"
export HNODECB_STAGE1PLUS_ARCH_STEP_RETRIES="${HNODECB_STAGE1PLUS_ARCH_STEP_RETRIES:-6}"
export HNODECB_STAGE1PLUS_ARCH_STEP_RETRY_LR_FACTOR="${HNODECB_STAGE1PLUS_ARCH_STEP_RETRY_LR_FACTOR:-0.1}"
export HNODECB_STAGE1PLUS_ARCH_STEP_MAX_LOSS_FRAC="${HNODECB_STAGE1PLUS_ARCH_STEP_MAX_LOSS_FRAC:-0.1}"
export HNODECB_JULIA_PROJECT="$REPO_DIR/HPC_env"
export JULIA_PROJECT="$REPO_DIR/HPC_env"

STAGE1PLUSLIGHT_LOG="logs/stage1pluslight_step2a/log2_03_step2a_stage1pluslight_driver_${SLURM_JOB_ID}.txt"
echo "Stage1pluslight HPC config: arch_screen_shards=$HNODECB_STAGE1PLUS_ARCH_SCREEN_SHARD_COUNT, main_search_shards=$HNODECB_STAGE1_SHARD_COUNT, arch_trials_per_arch=$HNODECB_STAGE1PLUS_ARCH_TRIALS_PER_ARCH, arch_epochs=$HNODECB_STAGE1PLUS_ARCH_EPOCHS, trials_per_shard=$HNODECB_STAGE1PLUS_TRIALS_PER_SHARD, total_trials=$HNODECB_STAGE1PLUS_TRIALS_PER_CANDIDATE"
stdbuf -oL -eL julia --project="$REPO_DIR/HPC_env" runner/stagewise/afm_param_search_stage1pluslight_03.jl 2>&1 | tee "$STAGE1PLUSLIGHT_LOG"
